{
  "version": 2,
  "builds": [
    {
      "src": "AYH/AYH/wsgi.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/staticfiles/$1"
    },
    {
      "src": "/(.*)",
      "dest": "AYH/AYH/wsgi.py"
    }
  ],
  "env": {
    "DJANGO_SETTINGS_MODULE": "AYH.settings"
  },
  "buildCommand": "cd AYH && python manage.py collectstatic --noinput"
}

