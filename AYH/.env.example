# Copy this file to .env and fill in your values.
# Do not commit .env to git.

DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=True
# DJANGO_ENV=production

# --- PostgreSQL (optional; if not set, SQLite is used) ---
# Option A: Single URL (e.g. from Vercel Postgres / Supabase)
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Option B: Individual vars (use your real host, database name, user, password)
# POSTGRES_HOST=your-db-host.example.com
# POSTGRES_NAME=your_database_name
# POSTGRES_USER=your_username
# POSTGRES_PASSWORD=your_password
# POSTGRES_PORT=5432
# POSTGRES_SSLMODE=require

# --- OTP SMS (for registration; send OTP to mobile) ---
# Option 1: Fast2SMS (India) – get API key at https://www.fast2sms.com/
# OTP_SMS_BACKEND=fast2sms
# FAST2SMS_API_KEY=your_fast2sms_dev_api_key

# Option 2: Twilio Verify (no from number; use Verify Service SID)
# OTP_SMS_BACKEND=twilio_verify
# TWILIO_ACCOUNT_SID=ACxxxxxxxx
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxx

# --- Google Sign-In (donor registration) – create OAuth 2.0 credentials at https://console.cloud.google.com/apis/credentials ---
# GOOGLE_OAUTH_CLIENT_ID=your_client_id.apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=your_client_secret
# Add authorized redirect URI: https://yourdomain.com/register/google/callback/ (and http://localhost:8000/register/google/callback/ for local)
