# Copy this file to .env and fill in your values.
# Do not commit .env to git.

DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=True
# DJANGO_ENV=production

# --- PostgreSQL (optional; if not set, SQLite is used) ---
# Option A: Single URL (e.g. from Vercel Postgres / Supabase)
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Option B: Individual vars (use your real host, database name, user, password)
# POSTGRES_HOST=your-db-host.example.com
# POSTGRES_NAME=your_database_name
# POSTGRES_USER=your_username
# POSTGRES_PASSWORD=your_password
# POSTGRES_PORT=5432
# POSTGRES_SSLMODE=require
